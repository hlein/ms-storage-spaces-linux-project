# Arch Linux package built from this source tree.
# Usage: cd contrib/arch && makepkg -si
pkgname=storage-spaces
pkgver=1.2.2
pkgrel=1
pkgdesc='Read, write and manage Microsoft Storage Spaces pools (Windows 11) on Linux'
# x86_64 only, the architecture the project is built and tested on (1.2.2
# also named aarch64, which was never built).
arch=('x86_64')
url='https://github.com/woffko/ms-storage-spaces-linux-project'
license=('GPL-2.0-or-later')
depends=('device-mapper' 'systemd' 'gcc-libs')
makedepends=('cargo' 'clang' 'python')
optdepends=('nbd: NBD backend (nbd-client)'
            'fuse3: FUSE backend and refs mount'
            'ntfs-3g: mounting NTFS volumes with FUSE (the kernel has ntfs3)')
install=storage-spaces.install
options=('!lto')

_root() {
  cd "$startdir/../.."
}

prepare() {
  _root
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  _root
  # The binaries name no path of this machine (as tools/build-static.sh).
  local remap="--remap-path-prefix=$srcdir/target=/target --remap-path-prefix=$PWD=/build"
  remap+=" --remap-path-prefix=${CARGO_HOME:-$HOME/.cargo}=/cargo"
  RUSTFLAGS="${RUSTFLAGS:+$RUSTFLAGS }$remap" CARGO_TARGET_DIR="$srcdir/target" \
    cargo build --frozen --release -p spaces-cli -p refs-cli
}

check() {
  _root
  CARGO_TARGET_DIR="$srcdir/target" cargo test --frozen --release -p storage-spaces -p refs --lib
}

package() {
  _root
  install -Dm755 "$srcdir/target/release/spaces" "$pkgdir/usr/bin/spaces"
  install -Dm755 "$srcdir/target/release/refs" "$pkgdir/usr/bin/refs"
  install -Dm755 contrib/mount.refs "$pkgdir/usr/bin/mount.ReFS"
  ln -sf mount.ReFS "$pkgdir/usr/bin/mount.refs"
  install -Dm644 contrib/udev/69-storage-spaces.rules "$pkgdir/usr/lib/udev/rules.d/69-storage-spaces.rules"
  for u in storage-spaces-attach.service storage-spaces-attach@.service; do
    sed 's#/usr/local/sbin/spaces#/usr/bin/spaces#' "contrib/systemd/$u" |
      install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/system/$u"
  done
  install -Dm644 contrib/man/spaces.8 "$pkgdir/usr/share/man/man8/spaces.8"
  install -Dm644 contrib/man/refs.1 "$pkgdir/usr/share/man/man1/refs.1"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  python tools/third-party-notices.py --target "$(rustc -vV | sed -n 's/host: //p')" \
    "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-NOTICES.txt"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 docs/user-guide.md "$pkgdir/usr/share/doc/$pkgname/user-guide.md"
}
