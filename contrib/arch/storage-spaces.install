# A unit of that name in /etc is the admin's or another installation's
# (contrib/install.sh), or a mask: whether it is enabled is theirs to say.
_own() {
  [ ! -e /etc/systemd/system/storage-spaces-attach.service ] && [ ! -L /etc/systemd/system/storage-spaces-attach.service ]
}

post_install() {
  systemctl daemon-reload
  _own && systemctl enable storage-spaces-attach.service
  udevadm control --reload
  modprobe ublk_drv 2>/dev/null || true
  modprobe nbd 2>/dev/null || true
  # The udev rule acts on disks that appear later: attach the pools whose
  # disks are here now.
  if _own; then
    systemctl start --no-block storage-spaces-attach.service || true
    echo "pools whose disks are here are being attached, the others at boot and when their disks appear"
  fi
}

post_upgrade() {
  systemctl daemon-reload
  udevadm control --reload
  # The spaces attached before are still served by the previous program:
  # detach those nothing uses, and attach them again as they were, with
  # this one. An upgrade keeps the unit enabled or not, as it was.
  /usr/bin/spaces detach --outdated || true
  if _own && systemctl --quiet is-enabled storage-spaces-attach.service; then
    systemctl start --no-block storage-spaces-attach.service || true
  fi
}

pre_remove() {
  # Detach what this package's spaces serves (and spaces without a server,
  # device-mapper only); the spaces another installation's spaces serves
  # (contrib/install.sh's in /usr/local) stay attached. pacman removes the
  # package whatever this says: a space in use stays attached, its server
  # running on with no program left to detach it.
  busy=
  for f in /run/storage-spaces/*.state; do
    [ -e "$f" ] || continue
    unit=$(sed -n 's/^unit=//p' "$f")
    space=$(sed -n 's/^space=//p' "$f")
    if [ -z "$unit" ] || systemctl show -p ExecStart --value "$unit" 2>/dev/null | grep -q 'path=/usr/bin/spaces '; then
      /usr/bin/spaces detach "$space" || busy="$busy $space"
    fi
  done
  if [ -n "$busy" ]; then
    echo "WARNING: the spaces$busy are in use and stay attached; their servers run on without this package." >&2
    echo "Stop using them, then remove their devices with dmsetup remove and stop their units (systemctl stop storage-spaces-GUID)." >&2
  fi
  _own && systemctl disable storage-spaces-attach.service
  return 0
}
