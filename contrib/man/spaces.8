.TH SPACES 8 "2026-10-22" "storage-spaces 1.3.0" "System Administration"
.SH NAME
spaces \- read, write and manage Microsoft Storage Spaces pools on Linux
.SH SYNOPSIS
.RB [ \-\-unclean\-parity
.IR refuse | data ]
.I command
.PP
.B spaces scan
.br
.B spaces attach
.RB [ \-\-pool
.IR name ]
.RB [ \-\-space
.IR name ]
.RB [ \-\-backend
.IR auto | dm | ublk | nbd | fuse ]
.RB [ \-\-degraded ]
.RB [ \-\-force ]
.RB [ \-\-rw ]
.RI [ device ...]
.br
.B spaces detach
.RB [ \-\-outdated ]
.RI [ space ]
.br
.B spaces detach \-\-leftovers
.br
.B spaces status
.br
.B spaces check
