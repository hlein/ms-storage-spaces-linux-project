[Unit]
Description=Attach Microsoft Storage Spaces pools read-only (member %I appeared)
Documentation=man:spaces(8) https://github.com/woffko/ms-storage-spaces-linux-project
DefaultDependencies=no
# udev starts one for every member disk that appears or changes (its
# MAJOR:MINOR): a disk that comes while a run goes on gets a run of its
# own, where a start of storage-spaces-attach.service would join the run
# that goes on, which had scanned the disks already (1.2.2 missed such a
# disk). After the coldplug and after the run at boot.
After=systemd-udevd.service systemd-udev-trigger.service systemd-modules-load.service storage-spaces-attach.service
Conflicts=shutdown.target
Before=shutdown.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
# Masking storage-spaces-attach.service turns attaching off here too.
ExecCondition=/bin/sh -c 'test "$$(systemctl is-enabled storage-spaces-attach.service 2>/dev/null)" != masked'
# Let the other members of a pool finish appearing first.
ExecStartPre=-/usr/bin/udevadm settle --timeout=30
ExecStart=/usr/local/sbin/spaces attach
# The run ends in time with what it did not get to said, rather than
# being killed: 30 s of settle, then at most 80 s of spaces attach.
TimeoutStartSec=120
Environment=SPACES_ATTACH_TIMEOUT=80

# This runs as root and parses the metadata of every disk that carries a
# Storage Spaces partition, whoever made it: it keeps what it needs (block
# devices, device-mapper, /run, the module loader) and nothing else. The
# servers it starts (systemd-run) get the same kind of limits from the
# program itself. Tested with the dm and ublk backends
# (docs/user-guide.md, "Hardening").
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run
# Pool disks may be image files in a home directory.
ProtectHome=read-only
# A /tmp of its own, but not through PrivateTmp=yes: that orders the unit
# after systemd-tmpfiles-setup.service, which comes after local-fs.target,
# and this runs before local-fs-pre.target: an ordering cycle at every
# boot, which systemd breaks by dropping jobs (mounts, this unit) at random.
# Not /var/tmp: a /var of its own is not mounted yet, and systemd would
# make the directory on the root file system, read-only that early.
TemporaryFileSystem=/tmp
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0077
CapabilityBoundingSet=~CAP_SYS_PTRACE CAP_SYS_BOOT CAP_SYS_TIME CAP_SYS_PACCT CAP_SYS_TTY_CONFIG \
    CAP_SYSLOG CAP_NET_ADMIN CAP_NET_RAW CAP_AUDIT_CONTROL CAP_AUDIT_READ CAP_AUDIT_WRITE \
    CAP_LINUX_IMMUTABLE CAP_MAC_ADMIN CAP_MAC_OVERRIDE CAP_WAKE_ALARM CAP_BLOCK_SUSPEND \
    CAP_PERFMON CAP_BPF CAP_CHECKPOINT_RESTORE CAP_SETPCAP CAP_SYS_CHROOT CAP_SETUID CAP_SETGID \
    CAP_KILL

